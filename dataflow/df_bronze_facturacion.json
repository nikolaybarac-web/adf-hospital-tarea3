{
	"name": "df_bronze_facturacion",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_Faturacion_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "Bronze_facturacion_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(19,4),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"csv select(mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"sql select(mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1 union(byName: true)~> union1"
			]
		}
	}
}