{
	"name": "df_silver_admisiones",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_admisiones",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_admisiones",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(admission_id = toInteger(trim(admission_id)),",
				"          patient_id = toInteger(trim(patient_id)),",
				"          admission_date = coalesce(\r",
				" toDate(admission_date, 'yyyy-MM-dd'),\r",
				" toDate(admission_date, 'MM/dd/yyyy'),\r",
				" toDate(admission_date, 'MM-dd-yy'),\r",
				" toDate(admission_date, 'dd-MMM-yyyy'),\r",
				" toDate(admission_date, 'MMMM dd, yyyy')\r",
				"),",
				"          discharge_date =  case(  regexMatch(trim(discharge_date), '^[0-9]{4}-'), toDate(trim(discharge_date), 'yyyy-MM-dd'),  regexMatch(trim(discharge_date), '^[0-9]{2}/'), toDate(trim(discharge_date), 'MM/dd/yyyy'),  regexMatch(trim(discharge_date), '^[0-9]{2}-[0-9]{2}-'), toDate(trim(discharge_date), 'MM-dd-yy'),  regexMatch(trim(discharge_date), '^[0-9]{2}-[A-Za-z]{3}-'), toDate(trim(discharge_date), 'dd-MMM-yyyy'),  toDate(trim(discharge_date), 'MMMM dd, yyyy') ),",
				"          department = case(\r",
				" upper(trim(department)) == 'ONCO' || upper(trim(department)) == 'ONCOLOGYY', 'ONCOLOGY',\r",
				" upper(trim(department)) == 'CARDIO' || upper(trim(department)) == 'CARDIOLGY', 'CARDIOLOGY',\r",
				" upper(trim(department)) == 'ER' || upper(trim(department)) == 'EMERGANCY', 'EMERGENCY',\r",
				" upper(trim(department)) == 'NEURO' || upper(trim(department)) == 'NUEROLOGY', 'NEUROLOGY',\r",
				" upper(trim(department)) == 'ORTHO' || upper(trim(department)) == 'ORTHOPAEDICS', 'ORTHOPEDICS',\r",
				" upper(trim(department)) == 'PEDS' || upper(trim(department)) == 'PAEDIATRICS', 'PEDIATRICS',\r",
				" upper(trim(department)) == 'GEN SURG' || upper(trim(department)) == 'GENERALSURGERY', 'GENERAL SURGERY',\r",
				" upper(trim(department))\r",
				"),",
				"          attending_doctor_id = toInteger(trim(attending_doctor_id))) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(patient_id) &&",
				"!isNull(admission_id) &&",
				"!isNull(admission_date) &&",
				"!isNull(discharge_date) &&",
				"!isNull(attending_doctor_id) &&",
				"!isNull(department) &&",
				"trim(department) != '') ~> filter1",
				"filter1 aggregate(groupBy(admission_id),",
				"     patient_id = first(patient_id),",
				"          admission_date = first(admission_date),",
				"          discharge_date = first(discharge_date),",
				"          department = first(department),",
				"          attending_doctor_id = first(attending_doctor_id)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id",
				"     )) ~> sink1"
			]
		}
	}
}