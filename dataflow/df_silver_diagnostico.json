{
	"name": "df_silver_diagnostico",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_diagnostico",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_diagnostico",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(diagnosis_id = toInteger(trim(toString(diagnosis_id))),",
				"          admission_id = toInteger(trim(toString(admission_id))),",
				"          icd_code = upper(trim(toString(icd_code))),",
				"          diagnosis_description = trim(toString(diagnosis_description)),",
				"          severity = upper(trim(toString(severity)))) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(diagnosis_id) &&",
				"!isNull(admission_id) &&",
				"!isNull(icd_code) &&",
				"!isNull(diagnosis_description) &&",
				"!isNull(severity) &&",
				"trim(icd_code) != '' &&",
				"trim(diagnosis_description) != '' &&",
				"trim(severity) != '') ~> filter1",
				"filter1 aggregate(groupBy(diagnosis_id),",
				"     admission_id = first(admission_id),",
				"          icd_code = first(icd_code),",
				"          diagnosis_description = first(diagnosis_description),",
				"          severity = first(severity)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     )) ~> sink1"
			]
		}
	}
}